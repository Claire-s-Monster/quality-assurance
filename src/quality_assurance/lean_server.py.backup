                    "target_paths": {"type": "array", "items": {"type": "string"}, "default": ["src/"], "description": "Paths to analyze"},
                    "parallel_execution": {"type": "boolean", "default": True, "description": "Execute tools in parallel"},
                    "quality_threshold": {"type": "number", "default": 8.0, "description": "Minimum quality score threshold"},
