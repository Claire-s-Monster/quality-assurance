    def _setup_meta_tools(self):
        """Setup the 3 meta-tools for dynamic discovery without filtering."""
        
        @self.app.tool(
            description="Discover quality assurance tools for linting, type-checking, security scanning, and code quality analysis (18 tools). USE WHEN: checking code quality, running ruff/mypy/bandit, analyzing quality trends, generating quality reports"
        )
        def discover_tools(pattern: Optional[str] = None) -> Dict[str, Any]:
            """
            Get available tools with minimal context consumption.

            Args:
                pattern: Filter by name pattern (substring match)

            Returns:
                Compact tool list with names and brief descriptions
            """
            tools = []
            
            for name, info in self.tool_registry.items():
                # Apply pattern filter if provided
                if pattern and pattern.lower() not in name.lower():
                    continue
                
                tools.append({
                    "name": name,
                    "description": info["description"]
                })
            
            return {
                "available_tools": tools,
                "total_tools": len(self.tool_registry),
                "filtered_count": len(tools)
            }
        
        @self.app.tool(
            description="Get full specification for specific quality assurance tool including schema and examples. USE WHEN: need parameter details for lint/typecheck/security tools before execution"
        )
        def get_tool_spec(tool_name: str) -> Dict[str, Any]:
            """
            Get full specification for specific tool including schema and examples.

            Args:
                tool_name: Name of tool to get specification for

            Returns:
                Complete tool specification with schema and usage details
            """
            if tool_name not in self.tool_registry:
                available_tools = list(self.tool_registry.keys())
                return {
                    "error": f"Tool '{tool_name}' not found",
                    "available_tools": available_tools
                }
            
            tool_info = self.tool_registry[tool_name]
            return {
                "name": tool_name,
                "description": tool_info["description"],
                "schema": tool_info["schema"]
            }
        
        @self.app.tool(
            description="Execute quality assurance tool with parameters. Supports lint, typecheck, security, formatting, and trend analysis. USE WHEN: running quality checks, applying auto-fixes, generating baseline reports"
        )
        def execute_tool(tool_name: str, parameters: Dict[str, Any]) -> Dict[str, Any]:
            """
            Execute tool with parameters using dynamic dispatch.

            Args:
                tool_name: Name of tool to execute
                parameters: Tool parameters as object

            Returns:
                Tool execution result with standard error handling
            """
            if tool_name not in self.tool_registry:
                available_tools = list(self.tool_registry.keys())
                return {
                    "error": f"Tool '{tool_name}' not found",
                    "available_tools": available_tools
                }
            
            try:
                # Import the main server module dynamically to access the tool functions
                from . import server as main_server
                
                # Get the tool function from the main server
                if hasattr(main_server, tool_name):
                    tool_func = getattr(main_server, tool_name)
                    result = tool_func(**parameters)
                    return {
                        "tool": tool_name,
                        "status": "success", 
                        "result": result
                    }
                else:
                    return {
                        "tool": tool_name,
                        "status": "error",
                        "error": f"Function '{tool_name}' not implemented in main server"
                    }
                    
            except Exception as e:
                logger.error(f"Error executing {tool_name}: {e}")
                return {
                    "tool": tool_name,
                    "status": "error",
                    "error": str(e)
                }
    
    def get_app(self) -> FastMCP:
        """Get the FastMCP app instance."""
        return self.app


def parse_args():
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(description="Quality Assurance Lean MCP Server")
    parser.add_argument(
        "--working-dir",
        type=str,
        default=".",
        help="Working directory path (default: current directory)"
    )
    parser.add_argument(
        "--repository", 
        type=str,
        default=None,
        help="Repository path (alias for --working-dir, for MCP compatibility)"
    )
    parser.add_argument(
        "--log-level",
        type=str,
        default="INFO", 
        choices=["DEBUG", "INFO", "WARNING", "ERROR"],
        help="Logging level (default: INFO)"
    )
    return parser.parse_args()


def setup_logging(log_level: str):
    """Setup logging configuration."""
    logging.basicConfig(
        level=getattr(logging, log_level),
        format='%(asctime)s [%(levelname)s] %(name)s: %(message)s'
    )


def main():
    """Main entry point for the lean MCP server."""
    try:
        args = parse_args()
        setup_logging(args.log_level)
        
        # Resolve working directory path - support both --working-dir and --repository
        working_dir_arg = args.repository if args.repository else args.working_dir
        working_dir = Path(working_dir_arg).resolve()
        logger.info(f"Initializing Quality Assurance Lean MCP server in: {working_dir}")
        
        # Create lean interface
        lean_mcp = QualityAssuranceLeanMCP(str(working_dir))
        app = lean_mcp.get_app()
        
        logger.info("Starting Quality Assurance Lean MCP server with meta-tool pattern")
        logger.info("Context consumption: ~300 tokens (vs 50-100K tokens for traditional MCP)")
        logger.info("Available functions: 18 quality tools via 3 meta-tools")
        
        # Run the server
        app.run()
        
    except KeyboardInterrupt:
        logger.info("Server stopped by user")
    except Exception as e:
        logger.error(f"Server error: {e}")
        raise


if __name__ == "__main__":
    main()